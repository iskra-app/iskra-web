# Боевой адрес Iskra Web. Кладётся в /etc/caddy/Caddyfile (или импортируется из него).
#
# /srv/iskra-web/releases/<коммит>/site/          — dist/ без служебных файлов
# /srv/iskra-web/releases/<коммит>/headers.caddy  — заголовки из security-headers.ts
# /srv/iskra-web/current -> releases/<коммит>     — переключает деплой
#
# Заголовки безопасности здесь не пишутся руками: их источник — security-headers.ts,
# сборка кладёт их в headers.caddy, деплой — рядом с сайтом, и `caddy reload` их подхватывает.

web.iskra.wtf {
	root * /srv/iskra-web/current/site
	encode zstd gzip

	import /srv/iskra-web/current/headers.caddy
	header Strict-Transport-Security "max-age=31536000"

	# Файлы с хэшем в имени не меняются никогда. Всё остальное — оболочка
	# (index.html, sw.js, манифест, иконки) — сверяется при каждом заходе: иначе новая
	# версия не доедет до тех, у кого старый sw.js в кэше браузера.
	@hashed path /assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"
	@shell not path /assets/*
	header @shell Cache-Control "no-cache"

	# Адрес на History API: любой путь приложения отдаёт index.html.
	try_files {path} /index.html
	file_server
}
